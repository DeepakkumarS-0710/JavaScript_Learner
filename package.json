{
  "name": "frontend-learning-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-study-guide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-study-guide.mjs",
    "build": "tsc -b && vite build",
    "copy:guide": "node scripts/copy-study-guide.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "compile:example": "tsc examples/typed-hello.ts --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck --outDir examples/compiled",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^3.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
